# Copiar a .env para desarrollo local, o cargar en las Variables del servicio de Railway.

# Obligatoria en produccion. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Nunca poner True en produccion.
DEBUG=False

# Hosts extra separados por coma. El dominio de Railway se agrega solo.
ALLOWED_HOSTS=

# Origenes extra para CSRF, separados por coma (con https://).
CSRF_TRUSTED_ORIGINS=

# La inyecta Railway al enlazar el servicio de Postgres. Sin ella se usa SQLite.
# DATABASE_URL=postgresql://usuario:password@host:puerto/basededatos

# Superusuario del admin: se crea en el arranque si no existe.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@grupointra.mx
DJANGO_SUPERUSER_PASSWORD=

# Numero de workers de gunicorn.
WEB_CONCURRENCY=2
